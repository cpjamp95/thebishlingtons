---
import Layout from "../layouts/Layout.astro";
import AppShell from "../components/layout/AppShell.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import WelcomeSection from "../components/sections/WelcomeSection.astro";
import MenuSection from "../components/sections/MenuSection.astro";
import TravelSection from "../components/sections/TravelSection.astro";
import { wedding } from "../data/wedding";
---

<Layout title={wedding.websiteName}>
  <AppShell>
    <main class="home-page">
      <div class="home-background" aria-hidden="true"></div>

      <div class="home-content">
        <HeroSection />
        <div class="guest-story" data-guest-home hidden>
          <WelcomeSection />
          <MenuSection />
          <TravelSection />
        </div>
      </div>
    </main>
  </AppShell>
</Layout>
