---
import InvitationFrame from "./InvitationFrame.astro";
import { wedding } from "../../data/wedding";
---

<div class="invitation-flip">
  <article class="invitation-card invitation-card--front">
    <InvitationFrame />

    <div class="invitation-card__content">
      <p class="invitation-card__eyebrow">THE WEDDING OF</p>

      <h1 class="invitation-card__names">
        {wedding.couple.partnerOne.firstName.toUpperCase()}
        <span class="surname">
          {wedding.couple.partnerOne.surname.toUpperCase()}
        </span>

        <span class="ampersand">&amp;</span>

        {wedding.couple.partnerTwo.firstName.toUpperCase()}
        <span class="surname">
          {wedding.couple.partnerTwo.surname.toUpperCase()}
        </span>
      </h1>

      <p class="invitation-card__details">
        {wedding.date.display.toUpperCase()}
        <br />
        {wedding.venue.name.toUpperCase()}
        <br />
        {wedding.venue.location.toUpperCase()}
      </p>

      <button
        type="button"
        class="invitation-card__rsvp"
        data-flip-card
        data-card-mode="rsvp"
        aria-label="RSVP"
      >
        RSVP
      </button>

      <p class="invitation-card__signin">
        Already registered?
        <button
          type="button"
          class="invitation-card__signin-link"
          data-flip-card
          data-card-mode="signin"
        >
          Sign In
        </button>
      </p>
    </div>
  </article>

  <article
    class="invitation-card invitation-card--back"
    inert
    aria-hidden="true"
  >
    <InvitationFrame />
    <div class="onboarding">
      <p class="onboarding__step" data-step>YOUR INVITATION</p>
      <p class="onboarding__preview" data-preview-note hidden>
        Local preview · fictional guests · no real account is created.
      </p>
      <section data-panel="code" hidden>
        <h2 tabindex="-1">You’re invited</h2>
        <p>Enter the invitation code included with your invitation.</p>
        <form data-code-form>
          <label for="invitation-code">Invitation code</label>
          <input
            id="invitation-code"
            name="code"
            required
            maxlength="80"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
          />
          <button type="submit" class="guest-button">Find my invitation</button>
        </form>
        <button type="button" class="guest-link" data-panel-link="signin"
          >Already registered? Sign in</button
        >
      </section>
      <section data-panel="household" hidden>
        <h2 tabindex="-1">An invitation for you</h2>
        <p class="onboarding__household" data-household-label></p>
        <ul class="onboarding__guests" data-household-guests></ul>
        <p data-household-type></p>
        <button type="button" class="guest-button" data-confirm-household
          >Yes, that’s us</button
        >
        <button type="button" class="guest-link" data-change-code
          >Use a different code</button
        >
      </section>
      <section data-panel="create" hidden>
        <h2 tabindex="-1">Make yourself at home</h2>
        <p data-create-copy>
          Create your account to keep your invitation close.
        </p>
        <form data-create-form>
          <label for="guest-name">Your name</label>
          <input
            id="guest-name"
            name="name"
            autocomplete="name"
            required
            maxlength="100"
          />
          <div data-real-credentials>
            <label for="create-email">Email address</label>
            <input
              id="create-email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
            <label for="create-password">Password</label>
            <input
              id="create-password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="12"
              required
              aria-describedby="password-help"
            />
            <p id="password-help" class="guest-help">At least 12 characters.</p>
          </div>
          <button type="submit" class="guest-button" data-create-submit
            >Create my account</button
          >
        </form>
        <button type="button" class="guest-link" data-panel-link="signin"
          >Already have an account? Sign in</button
        >
      </section>
      <section data-panel="signin" hidden>
        <h2 tabindex="-1">Welcome back</h2>
        <p>Sign in to your wedding invitation.</p>
        <form data-signin-form>
          <label for="signin-email">Email address</label>
          <input
            id="signin-email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
          <label for="signin-password">Password</label>
          <input
            id="signin-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
          <button type="submit" class="guest-button">Sign in</button>
        </form>
        <button type="button" class="guest-link" data-panel-link="reset"
          >Forgot your password?</button
        >
        <button type="button" class="guest-link" data-panel-link="code"
          >First visit? Find your invitation</button
        >
      </section>
      <section data-panel="verify" hidden>
        <h2 tabindex="-1">Check your inbox</h2>
        <p>
          If a new account can be created with that address, you’ll receive a
          confirmation email. Follow the link, then return here to sign in.
        </p>
        <p>Already registered? Sign in or reset your password instead.</p>
        <button type="button" class="guest-button" data-panel-link="signin"
          >Continue to sign in</button
        >
      </section>
      <section data-panel="reset" hidden>
        <h2 tabindex="-1">Let’s get you back in</h2>
        <p>We’ll send you a link to choose a new password.</p>
        <form data-reset-form>
          <label for="reset-email">Email address</label>
          <input
            id="reset-email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
          <button type="submit" class="guest-button">Send reset link</button>
        </form>
        <button type="button" class="guest-link" data-panel-link="signin"
          >Back to sign in</button
        >
      </section>
      <section data-panel="password" hidden>
        <h2 tabindex="-1">Choose a new password</h2>
        <form data-password-form>
          <label for="new-password">New password</label>
          <input
            id="new-password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="12"
            required
          />
          <p class="guest-help">At least 12 characters.</p>
          <button type="submit" class="guest-button">Save password</button>
        </form>
      </section>
      <p
        class="guest-feedback"
        data-feedback
        role="status"
        aria-live="polite"
        hidden
      >
      </p>
      <button
        type="button"
        class="guest-link onboarding__back"
        data-back-invitation>Back to invitation</button
      >
    </div>
  </article>
</div>

<script>
  import "../../scripts/onboarding";
</script>
